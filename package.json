{
  "name": "@zhangwansen123/dsh-skill-switch",
  "version": "1.0.1",
  "description": "Per-session switches for DSH skills: turn one on once and its rules apply to every reply at the level you picked, without naming it again.",
  "type": "module",
  "main": "index.js",
  "homepage": "https://github.com/dai428/dsh-skill-switch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dai428/dsh-skill-switch.git"
  },
  "bugs": {
    "url": "https://github.com/dai428/dsh-skill-switch/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "test",
    "icon.svg",
    "assets"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "skills",
    "skill-switch"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.2 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
